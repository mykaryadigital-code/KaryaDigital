# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# 1. TOYYIBPAY PAYMENT GATEWAY (MALAYSIA)
# ==========================================
# Dapatkan User Secret Key dan Category Code dari portal ToyyibPay (https://toyyibpay.com)
TOYYIBPAY_USER_SECRET_KEY="your_toyyibpay_user_secret_key_here"
TOYYIBPAY_CATEGORY_CODE="your_toyyibpay_category_code_here"
# Set true untuk sandbox (https://dev.toyyibpay.com), false untuk production
TOYYIBPAY_IS_SANDBOX="true"

# ==========================================
# 2. DATABASE SUPABASE (POSTGRESQL)
# ==========================================
# URL dan Secret Key daripada Supabase Project Settings > API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_secret_key"
SUPABASE_ANON_KEY="your_supabase_anon_public_key"

# ==========================================
# 3. CLOUDFLARE R2 (STORAGE FAIL E-BOOK)
# ==========================================
# Kredential S3-compatible API daripada Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="karyadigital-ebooks"
R2_PUBLIC_DOMAIN="https://assets.karyadigital.my"

# Secret key untuk tandatangan pautan masa terhad (Signed URL fallback)
SECURE_ASSET_SECRET="karya_secret_signing_key_2026_super_secure"

# ==========================================
# 4. BCL (BAYARCASH COMMERCE LAYER / BAYARCASH)
# ==========================================
# Dapatkan API Key dan Secret Key daripada portal BCL (https://bcl.my) atau Bayarcash (https://bayarcash.com)
BCL_API_KEY="your_bcl_api_key_here"
BCL_SECRET_KEY="your_bcl_secret_key_here"
BCL_PORTAL_KEY="your_bcl_portal_key_or_slug"
# Set true untuk ujian sandbox BCL, false untuk bayaran langsung sebenar
BCL_IS_SANDBOX="true"

# ==========================================
# 5. GOOGLE FIREBASE (FIRESTORE & AUTH)
# ==========================================
# Konfigurasi dimuat turun secara automatik ke dalam fail `firebase-applet-config.json`
# melalui proses provision AI Studio Firebase Enterprise Edition.

