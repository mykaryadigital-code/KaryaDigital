rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'mykaryadigital@gmail.com')
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection doc per skill instructions
    match /test/connection {
      allow read: if true;
    }

    // User Profile
    match /users/{userId} {
      allow get: if isOwner(userId) || isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isOwner(userId)
                    && isValidId(userId)
                    && incoming().uid == request.auth.uid
                    && incoming().email is string
                    && incoming().email.size() <= 150;
      allow update: if (isOwner(userId)
                    && incoming().uid == existing().uid
                    && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'email', 'updatedAt', 'isAuthor', 'bookmarks']))
                    || isSuperAdmin();
      allow delete: if isSuperAdmin();

      // User's Purchased Books Subcollection
      match /purchased_books/{bookId} {
        allow get: if isOwner(userId) || isSuperAdmin();
        allow list: if isOwner(userId) || isSuperAdmin();
        allow create: if isOwner(userId) || isSuperAdmin();
        allow update: if isOwner(userId) || isSuperAdmin();
        allow delete: if isSuperAdmin();
      }
    }

    // Orders Collection
    match /orders/{orderId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn()
                    && isValidId(orderId)
                    && incoming().userId == request.auth.uid
                    && incoming().userEmail is string
                    && incoming().userEmail.size() <= 150
                    && incoming().totalAmount is number
                    && incoming().totalAmount >= 0;
      allow update: if isSuperAdmin();
      allow delete: if false;
    }

    // Published Books Collection (Hanya Pengarang Asal atau Super Admin Boleh Edit / Padam)
    match /published_books/{bookId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && isValidId(bookId)
                    && (incoming().authorUid == request.auth.uid || isSuperAdmin());
      allow update: if isSignedIn()
                    && (existing().authorUid == request.auth.uid || isSuperAdmin());
      allow delete: if isSignedIn()
                    && (existing().authorUid == request.auth.uid || isSuperAdmin());
    }

    // Reviews Collection
    match /books/{bookId}/reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(reviewId);
      allow update: if false;
      allow delete: if isSuperAdmin();
    }
  }
}
